  "scenes": [
    {
      "id": "intro",
      "name": { "en": "Introduction", "fr": "Introduction" },
      "theme": "intro",
      "layout": "overlay",
      "playback": { "mode": "none" },
      "blocks": [
        {
          "id": "intro-map",
          "type": "view",
          "slot": "stage",
          "anchor": "center",
          "presentation": "background",
          "view": "intro-globe"
        },
        {
          "id": "intro-copy",
          "type": "copy",
          "slot": "copy",
          "variant": "hero",
          "label": {
            "en": "Planetary Signal — A live-data story",
            "fr": "Signal planétaire — Une histoire de données vivantes"
          },
          "heading": {
            "en": "The ocean is speaking",
            "fr": "L’océan nous parle"
          },
          "text": {
            "en": "Four signals, read directly from cloud-native environmental data.",
            "fr": "Quatre signaux lus directement dans des données environnementales cloud-native."
          }
        }
      ]
    },
    {
      "id": "arctic",
      "name": { "en": "Arctic", "fr": "Arctique" },
      "theme": "arctic",
      "layout": "split-left",
      "playback": { "mode": "autoplay" },
      "blocks": [
        {
          "id": "arctic-map",
          "type": "view",
          "slot": "stage",
          "anchor": "top-right",
          "presentation": "background",
          "view": "arctic-ice"
        },
        {
          "id": "arctic-copy",
          "type": "copy",
          "slot": "copy",
          "variant": "hero",
          "backdrop": "dark-gradient",
          "showTime": true,
          "label": { "en": "Signal 01 — Arctic", "fr": "Signal 01 — Arctique" },
          "heading": {
            "en": "Arctic",
            "fr": "Arctique"
          },
          "text": {
            "en": "Since 1979, its minimum September extent has declined by 12.8% per decade.",
            "fr": "Depuis 1979, son étendue minimale en septembre diminue de 12,8 % par décennie."
          },
          "references": [
            {
              "label": { "en": "IPCC SROCC", "fr": "GIEC/IPCC SROCC" },
              "url": "https://www.ipcc.ch/srocc/chapter/summary-for-policymakers/"
            }
          ]
        },
        {
          "id": "arctic-chart",
          "type": "widget",
          "slot": "analysis",
          "anchor": "bottom-right",
          "widget": "arctic-series",
          "config": { "view": "arctic-ice", "interactiveTime": true },
          "caption": {
            "en": "Daily modelled thickness at grid point 81.833°N, 5.667°W; June 2022–August 2026; 391 values.",
            "fr": "Épaisseur quotidienne modélisée au point de grille 81,833° N, 5,667° O ; juin 2022–août 2026 ; 391 valeurs."
          }
        }
      ]
    },
    {
      "id": "enso",
      "name": { "en": "ENSO", "fr": "ENSO" },
      "theme": "enso",
      "layout": "split-left",
      "playback": { "mode": "autoplay" },
      "blocks": [
        {
          "id": "enso-map",
          "type": "view",
          "slot": "stage",
          "anchor": "top-right",
          "presentation": "background",
          "view": "enso-pacific"
        },
        {
          "id": "enso-copy",
          "type": "copy",
          "slot": "copy",
          "variant": "hero",
          "showTime": true,
          "label": {
            "en": "Signal 02 — Equatorial Pacific",
            "fr": "Signal 02 — Pacifique équatorial"
          },
          "heading": {
            "en": "El Niño",
            "fr": "El Niño"
          },
          "text": {
            "en": "In August 2026, NOAA estimated a greater than 90% chance of a very strong event during fall and winter 2026–27.",
            "fr": "En août 2026, NOAA estimait à plus de 90 % la probabilité d’un épisode très intense durant l’automne-hiver 2026-2027."
          },
          "references": [
            {
              "label": {
                "en": "NOAA Climate Prediction Center",
                "fr": "NOAA Climate Prediction Center"
              },
              "url": "https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso/roni/archives/?month=08&type=strengths&year=2026"
            }
          ]
        },
        {
          "id": "enso-chart",
          "type": "widget",
          "slot": "analysis",
          "anchor": "bottom-right",
          "widget": "enso-series",
          "config": { "view": "enso-pacific", "interactiveTime": true },
          "caption": {
            "en": "Daily Copernicus Marine sea-surface temperature anomalies; area-weighted means in four Niño regions; February–August 2026.",
            "fr": "Anomalies quotidiennes de température de surface Copernicus Marine ; moyennes pondérées par surface dans quatre régions Niño ; février–août 2026."
          }
        }
      ]
    },
    {
      "id": "baltic",
      "name": { "en": "Baltic hypoxia", "fr": "Hypoxie baltique" },
      "theme": "baltic",
      "layout": "split-left",
      "playback": { "mode": "autoplay" },
      "blocks": [
        {
          "id": "baltic-map",
          "type": "view",
          "slot": "stage",
          "anchor": "top-right",
          "presentation": "background",
          "view": "baltic-oxygen"
        },
        {
          "id": "baltic-copy",
          "type": "copy",
          "slot": "copy",
          "variant": "hero",
          "backdrop": "dark-gradient",
          "showTime": true,
          "label": {
            "en": "Signal 03 — Baltic Sea",
            "fr": "Signal 03 — Mer Baltique"
          },
          "heading": {
            "en": "Baltic Sea",
            "fr": "Mer Baltique"
          },
          "text": {
            "en": "In 2016, hypoxia covered about 70,000 km² of seabed. Excess nutrient inputs are the main driver; warming and stratification worsen oxygen loss.",
            "fr": "En 2016, l’hypoxie couvrait environ 70 000 km² de fonds. Les excès de nutriments en sont le moteur principal ; réchauffement et stratification aggravent le déficit d’oxygène."
          },
          "references": [
            {
              "label": {
                "en": "HELCOM — State of the Baltic Sea",
                "fr": "HELCOM — État de la mer Baltique"
              },
              "url": "https://stateofthebalticsea.helcom.fi/wp-content/uploads/2023/11/Climate-change-chapter.pdf"
            }
          ]
        },
        {
          "id": "baltic-chart",
          "type": "widget",
          "slot": "analysis",
          "anchor": "bottom-right",
          "widget": "baltic-hypoxia",
          "config": { "view": "baltic-oxygen", "interactiveTime": true },
          "caption": {
            "en": "Copernicus Marine reanalysis; modelled seabed area below 2 mg/L O₂; monthly animation, September only in the graph with a five-year moving average; 1993–2025.",
            "fr": "Réanalyse Copernicus Marine ; surface modélisée des fonds sous 2 mg/L d’O₂ ; animation mensuelle, septembre seul dans le graphe et moyenne glissante sur cinq ans ; 1993–2025."
          }
        }
      ]
    },
    {
      "id": "mayotte",
      "name": { "en": "Mayotte", "fr": "Mayotte" },
      "theme": "mayotte",
      "layout": "split-left",
      "playback": {
        "mode": "sequence",
        "times": [
          "2024-12-14T00:00:00.000Z",
          "2024-12-14T03:00:00.000Z",
          "2024-12-14T06:00:00.000Z",
          "2024-12-14T09:00:00.000Z",
          "2024-12-14T12:00:00.000Z",
          "2024-12-14T15:00:00.000Z",
          "2024-12-14T18:00:00.000Z",
          "2024-12-14T21:00:00.000Z"
        ],
        "intervalMs": 2000,
        "direction": "loop"
      },
      "blocks": [
        {
          "id": "mayotte-map",
          "type": "view",
          "slot": "stage",
          "anchor": "center",
          "presentation": "background",
          "view": "mayotte-wind"
        },
        {
          "id": "mayotte-copy",
          "type": "copy",
          "slot": "copy",
          "variant": "hero",
          "showTime": true,
          "label": {
            "en": "Signal 04 — Mayotte, 14 December 2024",
            "fr": "Signal 04 — Mayotte, 14 décembre 2024"
          },
          "heading": {
            "en": "Cyclones",
            "fr": "Cyclones"
          },
          "text": {
            "en": "Chido struck Mayotte with gusts of 226 km/h and waves reaching 9.3 m. In a warmer climate, the strongest cyclones become more intense and represent a larger share.",
            "fr": "Chido a frappé Mayotte avec des rafales de 226 km/h et des vagues de 9,3 m. Dans un climat plus chaud, les cyclones extrêmes gagnent en puissance et en proportion."
          },
          "references": [
            {
              "label": { "en": "Météo-France", "fr": "Météo-France" },
              "url": "https://education.meteofrance.fr/actualites/le-cyclone-chido-a-frappe-mayotte-le-14-decembre-2024"
            },
            {
              "label": { "en": "IPCC AR6", "fr": "GIEC/IPCC AR6" },
              "url": "https://www.ipcc.ch/report/ar6/wg1/chapter/chapter-11/"
            }
          ]
        },
        {
          "id": "mayotte-chart",
          "type": "widget",
          "slot": "analysis",
          "anchor": "bottom-right",
          "widget": "mayotte-wind",
          "config": { "view": "mayotte-wind", "interactiveTime": true },
          "caption": {
            "en": "Hourly modelled wind at a grid point, not station gusts; IBTrACS track at three-hour intervals; 14 December 2024.",
            "fr": "Vent horaire modélisé au point de grille, et non rafales de station ; trajectoire IBTrACS par pas de trois heures ; 14 décembre 2024."
          }
        }
      ]
    },
    {
      "id": "outro",
      "name": { "en": "Conclusion", "fr": "Conclusion" },
      "theme": "intro",
      "layout": "overlay",
      "playback": { "mode": "none" },
      "blocks": [
        {
          "id": "outro-map",
          "type": "view",
          "slot": "stage",
          "anchor": "center",
          "presentation": "background",
          "view": "outro-globe"
        },
        {
          "id": "outro-copy",
          "type": "copy",
          "slot": "copy",
          "variant": "hero",
          "label": {
            "en": "Zartigl — Browser-native Zarr",
            "fr": "Zartigl — Zarr natif dans le navigateur"
          },
          "heading": { "en": "Follow the signal", "fr": "Suivez le signal" },
          "text": {
            "en": "Maps, timelines and measurements share one source of truth: the dataset itself.",
            "fr": "Cartes, chronologies et mesures partagent une même source de vérité : le jeu de données."
          }
        }
      ]
    }
  ]
}
