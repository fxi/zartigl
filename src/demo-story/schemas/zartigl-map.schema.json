{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zartigl.dev/schemas/story-view-zartigl-map-v1.json",
  "title": "Zartigl story view config",
  "type": "object",
  "required": ["camera"],
  "properties": {
    "layerId": { "type": "string" },
    "sourceId": { "type": "string" },
    "camera": {
      "type": "object",
      "required": ["center", "zoom"],
      "properties": {
        "center": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": { "type": "number" },
        "pitch": { "type": "number", "minimum": 0, "maximum": 85 },
        "bearing": { "type": "number" }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "method": { "enum": ["flyTo", "jumpTo"] },
        "durationMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "anchor": {
      "enum": ["center", "top-left", "top-right", "bottom-left", "bottom-right"]
    },
    "timeRange": { "type": "object" },
    "style": {
      "description": "Layer style over the catalog defaults, as src/catalog/style.ts.",
      "type": "object",
      "properties": {
        "palette": { "type": "string" },
        "renderMode": { "enum": ["particles", "raster", "raster+particles"] },
        "particles": {
          "type": "object",
          "properties": {
            "density": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.2
            },
            "speed": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "fade": { "type": "number", "minimum": 0, "maximum": 1 },
            "grade": {
              "oneOf": [
                { "enum": ["off", "vibrant"] },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "exposure": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "contrast": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "saturation": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "highlights": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              ]
            },
            "backdrop": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "color": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "raster": {
          "type": "object",
          "properties": {
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "logScale": { "type": "boolean" },
            "vibrance": { "type": "number", "minimum": -1, "maximum": 1 },
            "colorDomain": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "Engine tuning. Flat style keys (particleDensity, opacity…) are deprecated: use style.",
      "properties": {
        "particleState": { "enum": ["auto", "rgba8"] },
        "rgba8MaxParticleZoom": { "type": "number", "minimum": 0 }
      }
    },
    "overlays": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
