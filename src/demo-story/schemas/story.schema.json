{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zartigl.dev/schemas/story-v1.json",
  "title": "Story document",
  "type": "object",
  "required": ["schemaVersion", "defaultLocale", "title", "themes", "scenes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultLocale": { "type": "string", "minLength": 2 },
    "fallbackLocales": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "title": { "$ref": "#/definitions/localized" },
    "themes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/theme" } },
    "chrome": { "type": "object", "properties": { "verticalMark": { "$ref": "#/definitions/localized" } }, "additionalProperties": false },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/scene" } }
  },
  "additionalProperties": false,
  "definitions": {
    "localized": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "theme": { "type": "object", "required": ["background", "foreground", "muted", "accent", "accentSoft", "surface"], "properties": { "background": { "type": "string" }, "foreground": { "type": "string" }, "muted": { "type": "string" }, "accent": { "type": "string" }, "accentSoft": { "type": "string" }, "surface": { "type": "string" }, "glowAnchor": { "type": "string" } }, "additionalProperties": false },
    "reference": { "type": "object", "required": ["label", "url"], "properties": { "label": { "$ref": "#/definitions/localized" }, "url": { "type": "string", "format": "uri", "pattern": "^https?://" } }, "additionalProperties": false },
    "block": { "type": "object", "required": ["id", "type", "slot"], "properties": { "id": { "type": "string" }, "type": { "enum": ["copy", "view", "widget", "text", "credit", "label"] }, "slot": { "enum": ["copy", "stage", "analysis", "edge"] }, "anchor": { "enum": ["center", "top-left", "top-right", "bottom-left", "bottom-right"] }, "label": { "$ref": "#/definitions/localized" }, "heading": { "$ref": "#/definitions/localized" }, "text": { "$ref": "#/definitions/localized" }, "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/reference" } }, "showTime": { "type": "boolean" }, "backdrop": { "enum": ["none", "dark-gradient"] }, "orientation": { "enum": ["horizontal", "vertical-rl"] }, "variant": { "type": "string" }, "view": { "type": "string" }, "presentation": { "enum": ["background", "panel"] }, "widget": { "type": "string" }, "config": { "type": "object" }, "caption": { "$ref": "#/definitions/localized" } }, "additionalProperties": false },
    "scene": { "type": "object", "required": ["id", "name", "theme", "layout", "blocks"], "properties": { "id": { "type": "string" }, "name": { "$ref": "#/definitions/localized" }, "chapter": { "type": "string" }, "theme": { "type": "string" }, "layout": { "enum": ["full", "split-left", "split-right", "overlay"] }, "blocks": { "type": "array", "items": { "$ref": "#/definitions/block" } }, "playback": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["none", "autoplay", "sequence"] }, "times": { "type": "array", "items": { "type": "string", "format": "date-time" } }, "intervalMs": { "type": "number", "minimum": 1 }, "direction": { "enum": ["loop", "ping-pong"] } }, "additionalProperties": false } }, "additionalProperties": false }
  }
}
