    },
    "paragraphs": [
      {
        "en": "GRID-Geneva is a data and analytics centre established by the United Nations Environment Programme (UNEP) in 1985.",
        "fr": "GRID-Genève est un centre de données et d’analyse créé par le Programme des Nations Unies pour l’environnement (PNUE) en 1985."
      },
      {
        "en": "We transform data into actionable information and knowledge to support decision-making on environmental and social issues.",
        "fr": "Nous transformons les données en informations et en connaissances utiles à la décision sur les enjeux environnementaux et sociaux."
      }
    ],
