{
  "name": "@fxi/zartigl",
  "version": "0.3.1",
  "description": "MapLibre GL JS visualization for catalog-backed Zarr, WMTS, and GeoVideo data",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxi/zartigl.git"
  },
  "type": "module",
  "main": "./dist/zartigl.js",
  "module": "./dist/zartigl.js",
  "types": "./dist/zartigl.d.ts",
  "exports": {
    ".": {
      "import": "./dist/zartigl.js",
      "types": "./dist/zartigl.d.ts"
    },
    "./catalog": {
      "import": "./dist/catalog.js",
      "types": "./dist/catalog.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:story": "vite --config vite.config.story.ts",
    "dev:prod": "npm run dev",
    "test": "vitest run",
    "test:unit": "vitest run",
    "build": "vite build",
    "build:story": "vite build --config vite.config.story.ts",
    "build:prod": "npm run build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "release": "npm run release:patch",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "catalog": "npm run catalog:validate",
    "catalog:validate": "uv run scripts/catalog_builder/skills/validate_catalog.py",
    "catalog:validate:remote": "uv run scripts/catalog_builder/skills/validate_remote.py",
    "catalog:test-tools": "uv run python -m unittest discover -s scripts/catalog_builder/skills -p 'test_*.py'",
    "story:data": "uv run --project scripts python scripts/story_data/build.py",
    "test:story-data": "uv run --project scripts python -m unittest discover -s scripts/story_data -p 'test_*.py'",
    "geovideo:dry-run": "uv run scripts/geovideo/render.py scripts/geovideo/examples/sst-anomaly.json --dry-run",
    "geovideo:calibrate": "uv run scripts/geovideo/calibrate.py",
    "geovideo:calibrate:browser": "uv run scripts/geovideo/browser_calibrate.py",
    "smoke:sample": "npm run build:lib && node scripts/smoke-sample-point.mjs",
    "release:check": "npm run test && npm run catalog:validate && npm run build && npm run build:lib && npm run smoke:sample",
    "prepublishOnly": "npm run build:lib"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "maplibre",
    "zarr",
    "particles",
    "webgl",
    "ocean",
    "currents"
  ],
  "author": "fxi",
  "license": "MIT",
  "peerDependencies": {
    "maplibre-gl": ">=4.0.0"
  },
  "dependencies": {
    "numcodecs": "^0.3.2",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@types/d3": "^7.4.3",
    "@types/pako": "^2.0.4",
    "d3": "^7.9.0",
    "maplibre-gl": "^5.17.0",
    "tweakpane": "^4.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-glsl": "^1.5.5",
    "vitest": "^4.1.7"
  }
}
