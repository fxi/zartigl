{
  "product": "NOAA Coral Reef Watch Daily Global 5km Satellite Coral Bleaching Heat Stress Monitoring v3.1",
  "sourceUrl": "https://www.star.nesdis.noaa.gov/pub/socd/mecb/crw/data/5km/v3.1_op/nc/v1.0/daily/{family}/{year}/ct5km_{family}_v3.1_{date}.nc",
  "start": "2023-01-01",
  "publicationDelayDays": 3,
  "variables": {
    "degree_heating_week": "dhw",
    "bleaching_alert_area": "baa",
    "sea_surface_temperature_anomaly": "ssta",
    "hotspot": "hs"
  },
  "prefix": "netcdf-to-zarr/noaa/crw-dhw/v3.1",
  "stores": {
    "timeChunked": {"time": 1, "latitude": 600, "longitude": 1800},
    "geoChunked": {"time": 32, "latitude": 100, "longitude": 100}
  },
  "geoSyncMinLagDays": 7
}
