{
  "product": "CAMS Global Fire Assimilation System (GFAS) v1.4.2 daily",
  "dataset": "cams-global-fire-emissions-gfas",
  "request": {
    "time": ["00:00"],
    "temporal_aggregation": ["daily"],
    "data_format": "netcdf"
  },
  "variables": {
    "frpfire": {"request": "wildfire_radiative_power", "source": "frpfire", "longName": "Wildfire radiative power", "units": "W m-2", "dtype": "float32", "zeroAsFill": true},
    "offire": {"request": "wildfire_fraction_of_area_observed", "source": "offire", "longName": "Wildfire fraction of area observed", "units": "1", "dtype": "float32"},
    "crfire": {"request": "wildfire_combustion_rate", "source": "crfire", "longName": "Wildfire combustion rate", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "cfire": {"request": "wildfire_overall_flux_of_burnt_carbon", "source": "cfire", "longName": "Wildfire overall flux of burnt carbon", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "co2fire": {"request": "wildfire_flux_of_carbon_dioxide", "source": "co2fire", "longName": "Wildfire flux of carbon dioxide (CO2)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "ch4fire": {"request": "wildfire_flux_of_methane", "source": "ch4fire", "longName": "Wildfire flux of methane (CH4)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "n2ofire": {"request": "wildfire_flux_of_nitrous_oxide", "source": "n2ofire", "longName": "Wildfire flux of nitrous oxide (N2O)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "cofire": {"request": "wildfire_flux_of_carbon_monoxide", "source": "cofire", "longName": "Wildfire flux of carbon monoxide (CO)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "noxfire": {"request": "wildfire_flux_of_nitrogen_oxides", "source": "noxfire", "longName": "Wildfire flux of nitrogen oxides (NOx)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "so2fire": {"request": "wildfire_flux_of_sulphur_dioxide", "source": "so2fire", "longName": "Wildfire flux of sulphur dioxide (SO2)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "nh3fire": {"request": "wildfire_flux_of_ammonia", "source": "nh3fire", "longName": "Wildfire flux of ammonia (NH3)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "pm2p5fire": {"request": "wildfire_flux_of_particulate_matter_d_2_5_µm", "source": "pm2p5fire", "longName": "Wildfire flux of particulate matter d < 2.5 um (PM2.5)", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "bcfire": {"request": "wildfire_flux_of_black_carbon", "source": "bcfire", "longName": "Wildfire flux of black carbon", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "ocfire": {"request": "wildfire_flux_of_organic_carbon", "source": "ocfire", "longName": "Wildfire flux of organic carbon", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "tpmfire": {"request": "wildfire_flux_of_total_particulate_matter", "source": "tpmfire", "longName": "Wildfire flux of total particulate matter", "units": "kg m-2 s-1", "dtype": "float32", "zeroAsFill": true},
    "apt": {"request": "altitude_of_plume_top", "source": "apt", "longName": "Altitude of plume top", "units": "m", "scaleFactor": 1, "zeroAsFill": true},
    "apb": {"request": "altitude_of_plume_bottom", "source": "apb", "longName": "Altitude of plume bottom", "units": "m", "scaleFactor": 1, "zeroAsFill": true},
    "injh": {"request": "injection_height", "source": "injh", "longName": "Injection height (from IS4FIRES)", "units": "m", "scaleFactor": 1, "zeroAsFill": true}
  },
  "timeShiftHours": -12,
  "grid": {"latitude": [-89.95, 89.95, 1800], "longitude": [-179.95, 179.95, 3600]},
  "start": "2026-01-01",
  "stepsPerDay": 1,
  "requestDays": 7,
  "publicationDelayDays": 3,
  "prefix": "zarr/cams/gfas/v1.4.2",
  "stores": {
    "timeChunked": {"time": 1, "latitude": 600, "longitude": 1200},
    "geoChunked": {"time": 32, "latitude": 100, "longitude": 100}
  },
  "geoSyncMinLagDays": 7
}
